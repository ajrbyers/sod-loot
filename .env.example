# Copy to .env and fill in. Create a WCL client at https://www.warcraftlogs.com/api/clients
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Partition-scoped GraphQL endpoint; name+realm lookups only resolve on the
# partition hosting the character. Defaults to the SoD endpoint.
#WCL_API_URL=https://sod.warcraftlogs.com/api/v2/client

GUILD_ID=811296
PARSE_THRESHOLD=75
WEEKS_REQUIRED=4
WEEKS_WINDOW=8

# Leave blank to auto-detect the realm/region from the guild on WCL.
WCL_REALM_SLUG=
WCL_REGION=

# Blizzard API (current gear for the SoD set-bonus warning)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
BLIZZARD_NAMESPACE=profile-classic1x-eu
BLIZZARD_REALM_SLUG=wild-growth

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=1
