# Copy to /opt/sod-loot/.env and fill in. Keep this file OUT of git.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
BLIZZARD_NAMESPACE=profile-classic1x-eu
BLIZZARD_REALM_SLUG=wild-growth

GUILD_ID=811296
PARSE_THRESHOLD=75
WEEKS_REQUIRED=4
WEEKS_WINDOW=8
API_CACHE_SECONDS=10800

# Generate a random one, e.g. `python -c "import secrets;print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Include the hostname AND the server's public IP (users hit it by IP as the default site).
DJANGO_ALLOWED_HOSTS=nx01.janeway.systems,localhost,127.0.0.1
